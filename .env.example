# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# OpenAI API key (default LLM provider) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude API key (optional — only needed with --provider anthropic)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Notion Integration token — https://www.notion.so/my-integrations
# Create an internal integration, copy the "Internal Integration Token"
NOTION_TOKEN=secret_...


# Notion database ID (optional here — alternatively set notion.database_id in
# config/config.local.yaml). Copy it from the database URL:
#   https://notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=
